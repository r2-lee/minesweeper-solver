+package minesweeper.solver;
+
+import java.io.BufferedReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+public class AdaptiveGuessSearchTest {
+    public static void main(String[] args) throws Exception {
+        check(AdaptiveGuessSearch.meetsGate(4, 5, 200), "accept the exact 0.5-point threshold");
+        check(!AdaptiveGuessSearch.meetsGate(4, 5, 201), "reject one win out of 201");
+        check(!AdaptiveGuessSearch.meetsGate(4, 4, 100), "do not trigger on ties");
+        verifySyntheticCases();
+        for (String path : args) {
+            verifyRealCase(path);
+        }
+        System.out.println("AdaptiveGuessSearch focused tests passed");
+    }
+
+    private static void verifySyntheticCases() {
+        byte[][] tied = matrix("M1", "1M");
+        AdaptiveGuessSearch.Result result = AdaptiveGuessSearch.choose(tied, 0, 1_000);
+        check(result.choice == 0 && !result.triggered && result.nodes == 0,
+                "leave a dead 50/50 with the baseline");
+
+        byte[][] improved = matrix("M111", "0M11", "21M1");
+        result = AdaptiveGuessSearch.choose(improved, 1, 1_000);
+        check(result.choice == 0 && result.triggered && result.completed,
+                "zero is informative and can certify a winning change");
+
+        Random random = new Random(590748L);
+        int triggered = 0;
+        int incomplete = 0;
+        for (int i = 0; i < 240; i++) {
+            int cells = 4 + random.nextInt(4);
+            int mines = 1 + random.nextInt(cells - 1);
+            List<Integer> layouts = new ArrayList<Integer>();
+            for (int mask = 1; mask < (1 << cells); mask++) {
+                if (Integer.bitCount(mask) == mines) {
+                    layouts.add(mask);
+                }
+            }
+            Collections.shuffle(layouts, random);
+            int count = Math.min(2 + random.nextInt(17), layouts.size());
+            byte[][] clues = new byte[cells][count];
+            for (int c = 0; c < cells; c++) {
+                for (int w = 0; w < count; w++) {
+                    clues[c][w] = (byte) ((layouts.get(w) & (1 << c)) != 0 ? 9 : random.nextInt(4));
+                }
+            }
+            ExactReference ref = new ExactReference(clues);
+            int original = random.nextInt(cells);
+            int originalScore = ref.forced(original);
+            if (originalScore == 0) {
+                continue;
+            }
+            int optimum = ref.optimal();
+            AdaptiveGuessSearch.Result ample = AdaptiveGuessSearch.choose(clues, original, 100_000);
+            AdaptiveGuessSearch.Result limited = AdaptiveGuessSearch.choose(clues, original, 1);
+            for (AdaptiveGuessSearch.Result attempt : new AdaptiveGuessSearch.Result[]{ample, limited}) {
+                if (attempt.choice != original) {
+                    check(ref.forced(attempt.choice) > originalScore,
+                            "every changed move must beat the exact baseline");
+                }
+                if (attempt.completed && attempt.triggered) {
+                    check(ref.forced(attempt.choice) == optimum, "completed search returns the exact optimum");
+                }
+            }
+            check(limited.nodes <= 1, "deep search obeys the node limit");
+            check(ample.triggered == limited.triggered, "rollout gate is independent of deep budget");
+            if (ample.triggered) {
+                check(ample.completed, "small triggered matrix completed within a generous budget");
+                triggered++;
+                if (!limited.completed) {
+                    incomplete++;
+                }
+            } else {
+                check(ample.choice == original && ample.nodes == 0, "closed gate performs no deep work");
+            }
+        }
+        check(triggered > 5 && incomplete > 0, "fixtures exercise triggered and budget paths");
+        System.out.println("Synthetic cases included " + triggered + " triggered and " + incomplete + " budget cases");
+    }
+
+    private static void verifyRealCase(String path) throws Exception {
+        try (BufferedReader input = Files.newBufferedReader(Paths.get(path), StandardCharsets.US_ASCII)) {
+            String[] header = input.readLine().split("\\s+");
+            int worlds = Integer.parseInt(header[0]);
+            int cells = Integer.parseInt(header[1]);
+            int original = Integer.parseInt(header[2]);
+            byte[][] clues = new byte[cells][worlds];
+            for (int c = 0; c < cells; c++) {
+                String column = input.readLine();
+                check(column.length() == worlds, "matrix has the expected world count");
+                for (int w = 0; w < worlds; w++) {
+                    clues[c][w] = (byte) (column.charAt(w) == 'M' ? 9 : column.charAt(w) - '0');
+                }
+            }
+            AdaptiveGuessSearch.Result result = AdaptiveGuessSearch.choose(clues, original, 1_300_000);
+            if (!result.triggered) {
+                check(result.choice == original && result.nodes == 0, "real position preserves closed gate");
+            }
+            check(result.nodes <= 1_300_000, "real position honors the cap");
+            System.out.println(path + " choice=" + result.choice + " trigger=" + result.triggered
+                    + " completed=" + result.completed + " nodes=" + result.nodes);
+        }
+    }
+
+    private static byte[][] matrix(String... rows) {
+        byte[][] clues = new byte[rows[0].length()][rows.length];
+        for (int w = 0; w < rows.length; w++) {
+            for (int c = 0; c < clues.length; c++) {
+                char glyph = rows[w].charAt(c);
+                clues[c][w] = (byte) (glyph == 'M' ? 9 : glyph - '0');
+            }
+        }
+        return clues;
+    }
+
+    private static void check(boolean condition, String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static final class ExactReference {
+        private final byte[][] clues;
+        private final long all;
+        private final Map<Long, Integer> values = new HashMap<Long, Integer>();
+
+        ExactReference(byte[][] clues) {
+            this.clues = clues;
+            this.all = (1L << clues[0].length) - 1;
+        }
+
+        int optimal() {
+            return value(all);
+        }
+
+        int forced(int cell) {
+            long safe = 0;
+            for (int w = 0; w < clues[cell].length; w++) {
+                if (clues[cell][w] < 9) {
+                    safe |= 1L << w;
+                }
+            }
+            return value(safe);
+        }
+
+        int value(long belief) {
+            if (Long.bitCount(belief) <= 1) {
+                return belief == 0 ? 0 : 1;
+            }
+            Integer seen = values.get(belief);
+            if (seen != null) {
+                return seen;
+            }
+            int best = 1;
+            for (byte[] column : clues) {
+                long[] digits = new long[9];
+                for (long left = belief; left != 0; left &= left - 1) {
+                    int world = Long.numberOfTrailingZeros(left);
+                    if (column[world] < 9) {
+                        digits[column[world]] |= 1L << world;
+                    }
+                }
+                int score = 0;
+                for (long group : digits) {
+                    if (group == belief) {
+                        score = 0;
+                        break;
+                    }
+                    score += value(group);
+                }
+                best = Math.max(score, best);
+            }
+            values.put(belief, best);
+            return best;
+        }
+    }
+}
