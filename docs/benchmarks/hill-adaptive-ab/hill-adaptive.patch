+package minesweeper.solver;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import minesweeper.structure.Location;
+
+final class AdaptiveGuessLayouts {
+    static final int MAX_LAYOUTS = 40_000;
+    static final byte MINE = 9;
+
+    private static final int UNKNOWN = -1;
+    private static final int CONFIRMED = -2;
+    private static final int MAX_BOARD_CELLS = 4_096;
+    private static final int MAX_UNKNOWNS = 512;
+    private static final int COMPONENT_BUDGET = 1_000_000;
+
+    final Location[] cells;
+    final byte[][] clues;
+
+    private AdaptiveGuessLayouts(Location[] cells, byte[][] clues) {
+        this.cells = cells;
+        this.clues = clues;
+    }
+
+    /**
+     * Expands the posterior from confirmed mines, visible clues, and the game-wide
+     * mine count. The probability engine's count must agree before any result is used.
+     */
+    static AdaptiveGuessLayouts enumerate(BoardState board, int expectedCount) {
+        int width = board.getGameWidth();
+        int height = board.getGameHeight();
+        if (expectedCount < 1 || expectedCount > MAX_LAYOUTS || board.getTestMoveBalance() != 0
+                || width < 1 || height < 1 || (long) width * height > MAX_BOARD_CELLS) {
+            return null;
+        }
+
+        int area = width * height;
+        int[] visible = new int[area];
+        int[] columns = new int[area];
+        Arrays.fill(columns, -1);
+        List<Location> unknown = new ArrayList<>();
+        int confirmed = 0;
+        for (int i = 0; i < area; i++) {
+            int x = i % width;
+            int y = i / width;
+            if (board.isRevealed(x, y)) {
+                int clue = board.getWitnessValue(x, y);
+                if (clue < 0 || clue > 8 || board.isConfirmedMine(x, y)) {
+                    return null;
+                }
+                visible[i] = clue;
+            } else if (board.isConfirmedMine(x, y)) {
+                visible[i] = CONFIRMED;
+                confirmed++;
+            } else {
+                visible[i] = UNKNOWN;
+                columns[i] = unknown.size();
+                unknown.add(board.getLocation(x, y));
+            }
+        }
+
+        int mines = board.getMines() - confirmed;
+        int count = unknown.size();
+        if (count == 0 || count > MAX_UNKNOWNS || mines < 0 || mines > count) {
+            return null;
+        }
+
+        Location[] cells = unknown.toArray(new Location[0]);
+        int[][] neighbors = new int[count][];
+        int[] knownNeighbors = new int[count];
+        int[] parent = new int[count];
+        int[] degrees = new int[count];
+        for (int col = 0; col < count; col++) {
+            parent[col] = col;
+        }
+
+        List<Constraint> constraints = new ArrayList<>();
+        int[] adjacent = new int[8];
+        for (int i = 0; i < area; i++) {
+            if (visible[i] == CONFIRMED) {
+                continue;
+            }
+            int adjacentCount = 0;
+            int known = 0;
+            for (Location neighbor : board.getAdjacentSquaresIterable(board.getLocation(i % width, i / width))) {
+                int index = neighbor.y * width + neighbor.x;
+                if (visible[index] == CONFIRMED) {
+                    known++;
+                } else if (columns[index] >= 0) {
+                    adjacent[adjacentCount++] = columns[index];
+                }
+            }
+            if (visible[i] == UNKNOWN) {
+                neighbors[columns[i]] = Arrays.copyOf(adjacent, adjacentCount);
+                knownNeighbors[columns[i]] = known;
+                continue;
+            }
+
+            int required = visible[i] - known;
+            if (required < 0 || required > adjacentCount) {
+                return null;
+            }
+            if (adjacentCount != 0) {
+                int[] members = Arrays.copyOf(adjacent, adjacentCount);
+                constraints.add(new Constraint(members, required));
+                for (int col : members) {
+                    degrees[col]++;
+                    parent[root(parent, col)] = root(parent, members[0]);
+                }
+            }
+        }
+
+        List<Component> components = new ArrayList<>();
+        Component[] byRoot = new Component[count];
+        int[] outside = new int[count];
+        int outsideCount = 0;
+        for (int col = 0; col < count; col++) {
+            if (degrees[col] == 0) {
+                outside[outsideCount++] = col;
+            } else {
+                int key = root(parent, col);
+                if (byRoot[key] == null) {
+                    byRoot[key] = new Component();
+                    components.add(byRoot[key]);
+                }
+                byRoot[key].columns.add(col);
+            }
+        }
+        for (Constraint constraint : constraints) {
+            byRoot[root(parent, constraint.columns[0])].constraints.add(constraint);
+        }
+
+        // Counts beyond the expected total can never contribute to an accepted result.
+        int limit = expectedCount + 1;
+        WorkBudget budget = new WorkBudget();
+        for (Component component : components) {
+            if (!component.enumerate(degrees, count, mines, limit, budget)) {
+                return null;
+            }
+        }
+
+        int[][] suffix = layoutCounts(components, outsideCount, mines, limit);
+        if (suffix[0][mines] != expectedCount) {
+            return null;
+        }
+
+        byte[][] clues = new byte[count][expectedCount];
+        LayoutWriter writer = new LayoutWriter(components, Arrays.copyOf(outside, outsideCount),
+            suffix, neighbors, knownNeighbors, clues);
+        return writer.writeComponents(0, mines) && writer.written == expectedCount
+            ? new AdaptiveGuessLayouts(cells, clues) : null;
+    }
+
+    private static int root(int[] parent, int col) {
+        while (parent[col] != col) {
+            parent[col] = parent[parent[col]];
+            col = parent[col];
+        }
+        return col;
+    }
+
+    private static int[][] layoutCounts(List<Component> groups, int outsideCount, int mines, int limit) {
+        int[][] suffix = new int[groups.size() + 1][mines + 1];
+        int[] outside = suffix[groups.size()];
+        outside[0] = 1;
+        for (int i = 1; i <= outsideCount; i++) {
+            for (int k = Math.min(mines, i); k > 0; k--) {
+                outside[k] = Math.min(limit, outside[k] + outside[k - 1]);
+            }
+        }
+        for (int i = groups.size() - 1; i >= 0; i--) {
+            List<List<int[]>> options = groups.get(i).placements;
+            for (int used = 0; used < options.size(); used++) {
+                int ways = options.get(used).size();
+                if (ways != 0) {
+                    for (int remaining = 0; remaining <= mines - used; remaining++) {
+                        long more = (long) ways * suffix[i + 1][remaining];
+                        suffix[i][used + remaining] = (int) Math.min(limit, suffix[i][used + remaining] + more);
+                    }
+                }
+            }
+        }
+        return suffix;
+    }
+
+    private static final class Constraint {
+        final int[] columns;
+        final int required;
+
+        Constraint(int[] columns, int required) {
+            this.columns = columns;
+            this.required = required;
+        }
+    }
+
+    private static final class WorkBudget {
+        private int remaining = COMPONENT_BUDGET;
+
+        boolean spend(int cells) {
+            remaining -= cells;
+            return remaining >= 0;
+        }
+    }
+
+    private static final class Component {
+        final List<Integer> columns = new ArrayList<>();
+        final List<Constraint> constraints = new ArrayList<>();
+        final List<List<int[]>> placements = new ArrayList<>();
+
+        boolean enumerate(int[] degrees, int unknownCount, int mines, int limit, WorkBudget budget) {
+            columns.sort((a, b) -> Integer.compare(degrees[b], degrees[a]));
+            int size = columns.size();
+            int minUsed = Math.max(0, mines - (unknownCount - size));
+            int maxUsed = Math.min(mines, size);
+            for (int i = 0; i <= maxUsed; i++) {
+                placements.add(new ArrayList<>());
+            }
+            return new ComponentSearch(this, degrees, minUsed, maxUsed, limit, budget).place(0, 0);
+        }
+    }
+
+    private static final class ComponentSearch {
+        private final Component group;
+        private final int[] order;
+        private final int[][] incident;
+        private final int[] slots;
+        private final int[] required;
+        private final int[] selected;
+        private final int minUsed;
+        private final int maxUsed;
+        private final int limit;
+        private final WorkBudget budget;
+
+        ComponentSearch(Component group, int[] degrees, int minUsed, int maxUsed, int limit, WorkBudget budget) {
+            this.group = group;
+            this.minUsed = minUsed;
+            this.maxUsed = maxUsed;
+            this.limit = limit;
+            this.budget = budget;
+            order = new int[group.columns.size()];
+            incident = new int[order.length][];
+            int[] lookup = new int[degrees.length];
+            int[] fill = new int[order.length];
+            for (int i = 0; i < order.length; i++) {
+                order[i] = group.columns.get(i);
+                lookup[order[i]] = i;
+                incident[i] = new int[degrees[order[i]]];
+            }
+            slots = new int[group.constraints.size()];
+            required = new int[slots.length];
+            for (int i = 0; i < slots.length; i++) {
+                Constraint rule = group.constraints.get(i);
+                slots[i] = rule.columns.length;
+                required[i] = rule.required;
+                for (int col : rule.columns) {
+                    int pos = lookup[col];
+                    incident[pos][fill[pos]++] = i;
+                }
+            }
+            selected = new int[maxUsed];
+        }
+
+        boolean place(int position, int used) {
+            if (!budget.spend(1)) {
+                return false;
+            }
+            if (position == order.length) {
+                List<int[]> bucket = group.placements.get(used);
+                if (bucket.size() < limit) {
+                    if (!budget.spend(used)) {
+                        return false;
+                    }
+                    bucket.add(Arrays.copyOf(selected, used));
+                }
+                return true;
+            }
+
+            int minimum = used + order.length - position == minUsed ? 1 : 0;
+            int maximum = used == maxUsed ? 0 : 1;
+            int[] affected = incident[position];
+            for (int rule : affected) {
+                slots[rule]--;
+                if (required[rule] == 0) {
+                    maximum = 0;
+                } else if (required[rule] > slots[rule]) {
+                    minimum = 1;
+                }
+            }
+            if (minimum == 0 && !place(position + 1, used)) {
+                return false;
+            }
+            if (minimum <= maximum && maximum == 1) {
+                selected[used] = order[position];
+                for (int rule : affected) {
+                    required[rule]--;
+                }
+                if (!place(position + 1, used + 1)) {
+                    return false;
+                }
+                for (int rule : affected) {
+                    required[rule]++;
+                }
+            }
+            for (int rule : affected) {
+                slots[rule]++;
+            }
+            return true;
+        }
+    }
+
+    private static final class LayoutWriter {
+        private final List<Component> groups;
+        private final int[] outside;
+        private final int[][] suffix;
+        private final int[][] adjacent;
+        private final int[] knownAdjacent;
+        private final byte[][] clues;
+        private final boolean[] mines;
+        private int written;
+
+        LayoutWriter(List<Component> groups, int[] outside, int[][] suffix, int[][] adjacent,
+                     int[] knownAdjacent, byte[][] clues) {
+            this.groups = groups;
+            this.outside = outside;
+            this.suffix = suffix;
+            this.adjacent = adjacent;
+            this.knownAdjacent = knownAdjacent;
+            this.clues = clues;
+            this.mines = new boolean[clues.length];
+        }
+
+        boolean writeComponents(int index, int remaining) {
+            if (index == groups.size()) {
+                return writeOutside(0, remaining);
+            }
+            List<List<int[]>> options = groups.get(index).placements;
+            for (int count = 0; count < options.size() && count <= remaining; count++) {
+                if (suffix[index + 1][remaining - count] != 0) {
+                    for (int[] placement : options.get(count)) {
+                        for (int mine : placement) {
+                            mines[mine] = true;
+                        }
+                        if (!writeComponents(index + 1, remaining - count)) {
+                            return false;
+                        }
+                        for (int mine : placement) {
+                            mines[mine] = false;
+                        }
+                    }
+                }
+            }
+            return true;
+        }
+
+        private boolean writeOutside(int start, int remaining) {
+            if (remaining == 0) {
+                return writeLayout();
+            }
+            for (int i = start; i <= outside.length - remaining; i++) {
+                mines[outside[i]] = true;
+                if (!writeOutside(i + 1, remaining - 1)) {
+                    return false;
+                }
+                mines[outside[i]] = false;
+            }
+            return true;
+        }
+
+        private boolean writeLayout() {
+            if (written == clues[0].length) {
+                return false;
+            }
+            for (int col = 0; col < clues.length; col++) {
+                int clue = knownAdjacent[col];
+                if (mines[col]) {
+                    clue = MINE;
+                } else {
+                    for (int neighbor : adjacent[col]) {
+                        if (mines[neighbor]) {
+                            clue++;
+                        }
+                    }
+                }
+                clues[col][written] = (byte) clue;
+            }
+            written++;
+            return true;
+        }
+    }
+}
