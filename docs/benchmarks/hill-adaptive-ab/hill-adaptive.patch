+package minesweeper.solver;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+/** Searches the equiprobable layouts consistent with the visible board. */
+final class AdaptiveGuessSearch {
+    private static final int CLUES = 9;
+    private static final int MAX_LAYOUTS = 65_536;
+    private static final int CELL_BITS = 9;
+    private static final int CELL_MASK = (1 << CELL_BITS) - 1;
+    private static final int MASS_SHIFT = CELL_BITS + 4;
+    private static final int COUNT_BITS = 17;
+    private static final long COUNT_MASK = (1L << COUNT_BITS) - 1;
+    private static final long ROLLOUT = 1L << (COUNT_BITS * 2);
+    private static final long BOUND_MASK = (ROLLOUT << 1) - 1;
+
+    static final class Result {
+        final int choice;
+        final boolean triggered;
+        final boolean completed;
+        final long nodes;
+
+        Result(int choice, boolean triggered, boolean completed, long nodes) {
+            this.choice = choice;
+            this.triggered = triggered;
+            this.completed = completed;
+            this.nodes = nodes;
+        }
+    }
+
+    static Result choose(byte[][] clues, int original, int nodeLimit) {
+        int layouts = clues[original].length;
+        if (layouts < 2 || layouts > MAX_LAYOUTS || clues.length > CELL_MASK + 1) {
+            return new Result(original, false, false, 0);
+        }
+        return new AdaptiveGuessSearch(clues, layouts, Math.max(0, nodeLimit)).choose(original);
+    }
+
+    static boolean meetsGate(int originalGreedy, int bestGreedy, int layouts) {
+        long gain = (long) bestGreedy - originalGreedy;
+        return gain > 0 && 200L * gain >= layouts;
+    }
+
+    private final byte[][] clues;
+    private final char[] allWorlds;
+    private final int[] allColumns;
+    private final Frame[] frames;
+    private final Memo memo;
+    private final int nodeLimit;
+    private int nodes;
+    private boolean exhausted;
+
+    private AdaptiveGuessSearch(byte[][] clues, int layouts, int nodeLimit) {
+        this.clues = clues;
+        this.nodeLimit = nodeLimit;
+        allWorlds = new char[layouts];
+        for (int i = 0; i < layouts; i++) {
+            allWorlds[i] = (char) i;
+        }
+        allColumns = new int[clues.length];
+        for (int i = 0; i < clues.length; i++) {
+            allColumns[i] = i;
+        }
+        frames = new Frame[clues.length + 1];
+        memo = new Memo(layouts);
+    }
+
+    private Result choose(int original) {
+        List<Option> options = options(original);
+        Option baseline = options.get(0);
+        int bestGreedy = 0;
+        for (Option option : options) {
+            option.bound = rollout(option.worlds, 0, option.worlds.length, allColumns, clues.length, 0);
+            bestGreedy = Math.max(bestGreedy, lower(option.bound));
+        }
+        if (!meetsGate(lower(baseline.bound), bestGreedy, allWorlds.length)) {
+            return new Result(original, false, false, 0);
+        }
+
+        // Proving that Hill falls below the rollout witness suffices here.
+        refine(baseline, bestGreedy - 1);
+        int best = Math.max(bestGreedy, lower(baseline.bound));
+        Collections.sort(options, new Comparator<Option>() {
+            @Override
+            public int compare(Option a, Option b) {
+                int order = Integer.compare(lower(b.bound), lower(a.bound));
+                if (order == 0) {
+                    order = Integer.compare(upper(a.bound), upper(b.bound));
+                }
+                return order == 0 ? Integer.compare(a.column, b.column) : order;
+            }
+        });
+
+        for (Option option : options) {
+            if (option == baseline || exhausted) {
+                continue;
+            }
+            refresh(option);
+            if (upper(option.bound) > best) {
+                refine(option, best);
+                best = Math.max(best, lower(option.bound));
+            }
+        }
+
+        refresh(baseline);
+        Option selected = baseline;
+        for (Option option : options) {
+            refresh(option);
+            if (lower(option.bound) > upper(baseline.bound)
+                    && (selected == baseline || lower(option.bound) > lower(selected.bound)
+                        || (lower(option.bound) == lower(selected.bound) && option.column < selected.column))) {
+                selected = option;
+            }
+        }
+        boolean completed = !exhausted;
+        for (Option option : options) {
+            if (option != selected && upper(option.bound) > lower(selected.bound)) {
+                completed = false;
+                break;
+            }
+        }
+        return new Result(selected.column, true, completed, nodes);
+    }
+
+    private void refine(Option option, int cut) {
+        refresh(option);
+        if (upper(option.bound) > cut) {
+            long refined = search(option.worlds, 0, option.worlds.length, allColumns,
+                    clues.length, cut, 0);
+            option.bound = intersect(option.bound, refined);
+        }
+    }
+
+    private void refresh(Option option) {
+        option.bound = intersect(option.bound,
+                known(option.worlds, 0, option.worlds.length, option.hash));
+    }
+
+    private List<Option> options(int original) {
+        int baselineMass = 0;
+        int safest = original;
+        int maximumMass = -1;
+        int[] ordered = new int[clues.length];
+        int candidates = 0;
+        for (int cell = 0; cell < clues.length; cell++) {
+            byte[] observations = clues[cell];
+            if (observations.length != allWorlds.length) {
+                throw new IllegalArgumentException("Unequal adaptive layout counts");
+            }
+            int safe = 0;
+            int digits = 0;
+            for (byte clue : observations) {
+                if (clue < CLUES) {
+                    safe++;
+                    digits |= 1 << clue;
+                }
+            }
+            if (cell == original) {
+                baselineMass = safe;
+            }
+            if (safe > maximumMass) {
+                maximumMass = safe;
+                safest = cell;
+            }
+            if (Integer.bitCount(digits) > 1) {
+                ordered[candidates++] = rank(cell, safe, 0);
+            }
+        }
+
+        List<Option> result = new ArrayList<Option>();
+        result.add(option(original, baselineMass));
+        if (safest != original) {
+            result.add(option(safest, maximumMass));
+        }
+        List<Option> maximal = new ArrayList<Option>();
+        Arrays.sort(ordered, 0, candidates);
+        for (int i = candidates - 1; i >= 0; i--) {
+            int cell = cell(ordered[i]);
+            Option candidate = cell == original ? result.get(0)
+                    : cell == safest ? result.get(1) : option(cell, mass(ordered[i]));
+            boolean contained = false;
+            for (Option previous : maximal) {
+                if (contains(previous.worlds, candidate.worlds)) {
+                    contained = true;
+                    break;
+                }
+            }
+            if (!contained) {
+                maximal.add(candidate);
+                if (cell != original && cell != safest) {
+                    result.add(candidate);
+                }
+            }
+        }
+        return result;
+    }
+
+    private Option option(int column, int size) {
+        if (size == allWorlds.length) {
+            return new Option(column, allWorlds);
+        }
+        char[] worlds = new char[size];
+        int index = 0;
+        byte[] observations = clues[column];
+        for (int i = 0; i < observations.length; i++) {
+            if (observations[i] < CLUES) {
+                worlds[index++] = (char) i;
+            }
+        }
+        return new Option(column, worlds);
+    }
+
+    private static boolean contains(char[] superset, char[] subset) {
+        if (superset.length < subset.length) {
+            return false;
+        }
+        int i = 0;
+        for (char world : subset) {
+            while (i < superset.length && superset[i] < world) {
+                i++;
+            }
+            if (i == superset.length || superset[i] != world) {
+                return false;
+            }
+            i++;
+        }
+        return true;
+    }
+
+    private long rollout(char[] worlds, int start, int size, int[] columns, int count, int depth) {
+        long hash = hash(worlds, start, size);
+        long previous = known(worlds, start, size, hash);
+        if (exact(previous) || (previous & ROLLOUT) != 0) {
+            return previous;
+        }
+        Frame frame = frame(depth);
+        int action = fill(frame, worlds, start, size, columns, count);
+        if (action == 0) {
+            return save(worlds, start, size, hash, bounds(1, 1) | ROLLOUT, previous, false);
+        }
+        partition(frame, worlds, start, size, action);
+        boolean certain = mass(action) == size;
+        int[] active = certain ? columns : frame.active;
+        int activeCount = certain ? count : frame.actionsCount;
+        int lo = 0;
+        int hi = 0;
+        for (int digit = 0; digit < CLUES; digit++) {
+            long child = rollout(frame.partitions, frame.offset[digit], frame.counts[digit],
+                    active, activeCount, depth + 1);
+            lo += lower(child);
+            hi += upper(child);
+        }
+        long outcome = bounds(lo, certain ? hi : mass(action)) | ROLLOUT;
+        return save(worlds, start, size, hash, outcome, previous, false);
+    }
+
+    private long search(char[] worlds, int start, int size, int[] columns, int count, int cut, int depth) {
+        long hash = hash(worlds, start, size);
+        long previous = known(worlds, start, size, hash);
+        if (exact(previous) || upper(previous) <= cut || exhausted) {
+            return previous;
+        }
+        if (nodes == nodeLimit) {
+            exhausted = true;
+            return previous;
+        }
+        nodes++;
+        Frame frame = frame(depth);
+        int first = fill(frame, worlds, start, size, columns, count);
+        if (first == 0) {
+            return save(worlds, start, size, hash, bounds(1, 1), previous, true);
+        }
+        if (mass(first) == size) {
+            long scores = score(frame, worlds, start, size, columns, count, first, cut, depth);
+            return save(worlds, start, size, hash, scores, previous, true);
+        }
+
+        int lo = lower(previous);
+        int hi = lo;
+        int seen = 0;
+        Arrays.sort(frame.actions, 0, frame.actionsCount);
+        for (int i = frame.actionsCount - 1; i >= 0; i--) {
+            int action = frame.actions[i];
+            int threshold = Math.max(cut, lo);
+            if (mass(action) <= threshold || exhausted) {
+                hi = Math.max(hi, mass(action));
+                break;
+            }
+            int column = cell(action);
+            if (dominated(worlds, start, size, column, frame.explored, seen)) {
+                continue;
+            }
+            frame.explored[seen++] = column;
+            long alternative = score(frame, worlds, start, size, frame.active,
+                    frame.actionsCount, action, threshold, depth);
+            lo = Math.max(lo, lower(alternative));
+            hi = Math.max(hi, upper(alternative));
+            if (lo == upper(previous)) {
+                hi = lo;
+                break;
+            }
+        }
+        return save(worlds, start, size, hash, bounds(lo, hi), previous, true);
+    }
+
+    private long score(Frame frame, char[] worlds, int start, int size, int[] columns,
+            int count, int action, int cut, int depth) {
+        partition(frame, worlds, start, size, action);
+        int lo = 0;
+        int hi = 0;
+        int branches = 0;
+        for (int digit = 0; digit < CLUES; digit++) {
+            int offset = frame.offset[digit];
+            int length = frame.counts[digit];
+            if (length == 0) {
+                continue;
+            }
+            long hash = hash(frame.partitions, offset, length);
+            long prior = known(frame.partitions, offset, length, hash);
+            frame.prior[digit] = prior;
+            lo += lower(prior);
+            hi += upper(prior);
+            if (!exact(prior)) {
+                int i = branches++;
+                while (i > 0 && frame.counts[frame.order[i - 1]] < length) {
+                    frame.order[i] = frame.order[i - 1];
+                    i--;
+                }
+                frame.order[i] = digit;
+            }
+        }
+        for (int i = 0; i < branches && hi > cut && !exhausted; i++) {
+            int digit = frame.order[i];
+            long prior = frame.prior[digit];
+            long child = search(frame.partitions, frame.offset[digit], frame.counts[digit],
+                    columns, count, cut - (hi - upper(prior)), depth + 1);
+            lo += lower(child) - lower(prior);
+            hi += upper(child) - upper(prior);
+        }
+        return bounds(lo, hi);
+    }
+
+    private int fill(Frame frame, char[] worlds, int start, int size, int[] columns, int count) {
+        int best = 0;
+        frame.actionsCount = 0;
+        for (int i = 0; i < count; i++) {
+            int column = columns[i];
+            byte[] observations = clues[column];
+            int alive = 0;
+            int digits = 0;
+            for (int w = start; w < start + size; w++) {
+                byte clue = observations[worlds[w]];
+                if (clue < CLUES) {
+                    alive++;
+                    digits |= 1 << clue;
+                }
+            }
+            int distinct = Integer.bitCount(digits);
+            if (distinct > 1) {
+                int action = rank(column, alive, distinct);
+                if (alive == size) {
+                    // Column lists keep row-major order for risk-free tie-breaking.
+                    return action;
+                }
+                int next = frame.actionsCount++;
+                frame.active[next] = column;
+                frame.actions[next] = action;
+                best = Math.max(best, action);
+            }
+        }
+        return best;
+    }
+
+    private void partition(Frame frame, char[] worlds, int start, int size, int action) {
+        byte[] observations = clues[cell(action)];
+        Arrays.fill(frame.counts, 0);
+        for (int i = start; i < start + size; i++) {
+            int digit = observations[worlds[i]];
+            if (digit < CLUES) {
+                frame.counts[digit]++;
+            }
+        }
+        int offset = 0;
+        for (int digit = 0; digit < CLUES; digit++) {
+            frame.offset[digit] = offset;
+            frame.next[digit] = offset;
+            offset += frame.counts[digit];
+        }
+        if (frame.partitions.length < offset) {
+            frame.partitions = new char[Math.max(offset, frame.partitions.length * 2)];
+        }
+        for (int i = start; i < start + size; i++) {
+            char world = worlds[i];
+            int digit = observations[world];
+            if (digit < CLUES) {
+                frame.partitions[frame.next[digit]++] = world;
+            }
+        }
+    }
+
+    private boolean dominated(char[] worlds, int start, int size, int column, int[] seen, int count) {
+        byte[] current = clues[column];
+        for (int i = 0; i < count; i++) {
+            byte[] earlier = clues[seen[i]];
+            int w = start;
+            for (; w < start + size; w++) {
+                char world = worlds[w];
+                if (current[world] < CLUES && earlier[world] == CLUES) {
+                    break;
+                }
+            }
+            if (w == start + size) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private long known(char[] worlds, int start, int size, long hash) {
+        if (size <= 1) {
+            return bounds(size, size);
+        }
+        long value = memo.get(worlds, start, size, hash);
+        return value == 0 ? bounds(1, size) : value;
+    }
+
+    private long save(char[] worlds, int start, int size, long hash, long value, long prior, boolean deep) {
+        long span = intersect(value, prior);
+        if (!memo.put(worlds, start, size, hash, span) && deep) {
+            exhausted = true;
+        }
+        return span;
+    }
+
+    private Frame frame(int depth) {
+        if (frames[depth] == null) {
+            frames[depth] = new Frame(clues.length);
+        }
+        return frames[depth];
+    }
+
+    // Rank sorts by safe mass, number of observed digits, then row-major order.
+    private static int rank(int column, int mass, int digits) {
+        return (mass << MASS_SHIFT) | (digits << CELL_BITS) | (CELL_MASK - column);
+    }
+
+    private static int cell(int rank) {
+        return CELL_MASK - (rank & CELL_MASK);
+    }
+
+    private static int mass(int rank) {
+        return rank >>> MASS_SHIFT;
+    }
+
+    private static long bounds(int lo, int hi) {
+        return ((long) hi << COUNT_BITS) | lo;
+    }
+
+    private static int lower(long bound) {
+        return (int) (bound & COUNT_MASK);
+    }
+
+    private static int upper(long bound) {
+        return (int) ((bound >>> COUNT_BITS) & COUNT_MASK);
+    }
+
+    private static boolean exact(long bound) {
+        return lower(bound) == upper(bound);
+    }
+
+    private static long intersect(long a, long b) {
+        int lo = Math.max(lower(a), lower(b));
+        int hi = Math.min(upper(a), upper(b));
+        if (lo > hi) {
+            throw new IllegalStateException("Inconsistent adaptive search bounds");
+        }
+        return bounds(lo, hi) | ((a | b) & ROLLOUT);
+    }
+
+    private static long hash(char[] worlds, int start, int size) {
+        if (size <= 1) {
+            return 0;
+        }
+        long hash = 0xcbf29ce484222325L;
+        for (int i = start; i < start + size; i++) {
+            hash = (hash ^ worlds[i]) * 0x100000001b3L;
+        }
+        hash ^= hash >>> 32;
+        hash *= 0xd6e8feb86659fd93L;
+        return (hash ^ (hash >>> 32)) | 1;
+    }
+
+    private static final class Option {
+        final int column;
+        final char[] worlds;
+        final long hash;
+        long bound;
+
+        Option(int column, char[] worlds) {
+            this.column = column;
+            this.worlds = worlds;
+            hash = hash(worlds, 0, worlds.length);
+        }
+    }
+
+    private static final class Frame {
+        final int[] actions;
+        final int[] active;
+        final int[] explored;
+        final int[] counts = new int[CLUES];
+        final int[] offset = new int[CLUES];
+        final int[] next = new int[CLUES];
+        final int[] order = new int[CLUES];
+        final long[] prior = new long[CLUES];
+        char[] partitions = new char[0];
+        int actionsCount;
+
+        Frame(int cells) {
+            actions = new int[cells];
+            active = new int[cells];
+            explored = new int[cells];
+        }
+    }
+
+    /** Stores immutable world sets and checks equality on every hash match. */
+    private static final class Memo {
+        private static final int MEMORY_LIMIT = 96 << 20;
+        private static final int SLOT_BYTES = 20;
+        private static final int SIZE_SHIFT = COUNT_BITS * 2 + 1;
+        private final int chunkBits;
+        private final int chunkSize;
+        private final ArrayList<char[]> chunks = new ArrayList<char[]>();
+        private long[] hashes = new long[256];
+        private int[] offsets = new int[256];
+        private long[] values = new long[256];
+        private int entries;
+        private int next;
+
+        Memo(int worlds) {
+            chunkBits = 32 - Integer.numberOfLeadingZeros(Math.max(4_096, worlds) - 1);
+            chunkSize = 1 << chunkBits;
+            next = chunkSize;
+        }
+
+        long get(char[] worlds, int start, int size, long hash) {
+            return values[slot(worlds, start, size, hash)] & BOUND_MASK;
+        }
+
+        boolean put(char[] worlds, int start, int size, long hash, long value) {
+            int slot = slot(worlds, start, size, hash);
+            if (hashes[slot] != 0) {
+                values[slot] = value | ((long) size << SIZE_SHIFT);
+                return true;
+            }
+            if ((entries + 1) * 4 > hashes.length * 3) {
+                if (!grow()) {
+                    return false;
+                }
+                slot = slot(worlds, start, size, hash);
+            }
+            if (next + size > chunkSize) {
+                if (!canAllocate(chunkSize * 2)) {
+                    return false;
+                }
+                chunks.add(new char[chunkSize]);
+                next = 0;
+            }
+            System.arraycopy(worlds, start, chunks.get(chunks.size() - 1), next, size);
+            hashes[slot] = hash;
+            offsets[slot] = ((chunks.size() - 1) << chunkBits) | next;
+            values[slot] = value | ((long) size << SIZE_SHIFT);
+            next += size;
+            entries++;
+            return true;
+        }
+
+        private int slot(char[] worlds, int start, int size, long hash) {
+            int mask = hashes.length - 1;
+            int slot = (int) (hash >>> 1) & mask;
+            while (hashes[slot] != 0) {
+                if (hashes[slot] == hash && values[slot] >>> SIZE_SHIFT == size
+                        && matches(worlds, start, size, offsets[slot])) {
+                    break;
+                }
+                slot = (slot + 1) & mask;
+            }
+            return slot;
+        }
+
+        private boolean matches(char[] worlds, int start, int size, int offset) {
+            char[] stored = chunks.get(offset >>> chunkBits);
+            int index = offset & (chunkSize - 1);
+            for (int i = 0; i < size; i++) {
+                if (worlds[start + i] != stored[index + i]) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        private boolean canAllocate(int bytes) {
+            long used = (long) hashes.length * SLOT_BYTES + (long) chunks.size() * chunkSize * 2;
+            return used + bytes <= MEMORY_LIMIT;
+        }
+
+        private boolean grow() {
+            int capacity = hashes.length * 2;
+            if (!canAllocate(capacity * SLOT_BYTES)) {
+                return false;
+            }
+            long[] oldHashes = hashes;
+            int[] oldOffsets = offsets;
+            long[] oldValues = values;
+            hashes = new long[capacity];
+            offsets = new int[capacity];
+            values = new long[capacity];
+            int mask = capacity - 1;
+            for (int i = 0; i < oldHashes.length; i++) {
+                long hash = oldHashes[i];
+                if (hash != 0) {
+                    int next = (int) (hash >>> 1) & mask;
+                    while (hashes[next] != 0) {
+                        next = (next + 1) & mask;
+                    }
+                    hashes[next] = hash;
+                    offsets[next] = oldOffsets[i];
+                    values[next] = oldValues[i];
+                }
+            }
+            return true;
+        }
+    }
+}
